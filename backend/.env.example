# 环境变量示例：复制为 backend/.env 后修改
# Windows: copy .env.example .env
# Linux/Mac: cp .env.example .env

# 数据库（默认 SQLite；PostgreSQL 例：postgresql+psycopg2://user:pass@host:5432/autoops）
DATABASE_URL=sqlite:///./autoops.db

# ===== 生产必改 =====
# 生成方式：openssl rand -base64 48
SECRET_KEY=please-change-me-in-production
# 凭据 AES-256-GCM 加密密钥，至少 32 字节：openssl rand -base64 32
# 注意：改这个值会导致已保存的凭据无法解密，上线后不要再改
CREDENTIAL_SECRET=please-change-me-at-least-32-bytes

# 登录态有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 执行引擎：mock / ansible
EXECUTOR_BACKEND=mock

# 大模型（OpenAI 兼容接口，留空则 AI 生成走内置模板）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 允许的跨域来源（逗号分隔；用 nginx 同源部署时可只填域名）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端地址：SSO 回调后跳转用
FRONTEND_URL=http://localhost:5173

# ===== 任务产物归档 =====
# local：本地磁盘（默认）；s3：任意 S3 兼容对象存储（需 pip install boto3）
ARTIFACT_BACKEND=local
ARTIFACT_DIR=./data/artifacts
# ARTIFACT_S3_ENDPOINT=http://127.0.0.1:9000        # MinIO 示例；AWS S3 留空
# ARTIFACT_S3_BUCKET=autoops-artifacts
# ARTIFACT_S3_ACCESS_KEY=
# ARTIFACT_S3_SECRET_KEY=
# ARTIFACT_S3_REGION=us-east-1
# 产物保留天数（0 = 永久保留；仅 local 后端生效，每天 03:30 由调度器清理）
ARTIFACT_RETENTION_DAYS=30

# ===== 主机探活 =====
# tcp：连 SSH 端口（推荐，云主机常禁 ping）；ping：ICMP（容器内已装 iputils-ping）
PROBE_METHOD=tcp
PROBE_TIMEOUT_SECONDS=3
PROBE_WORKERS=32
# 定时探活间隔（分钟），0 = 关闭定时探测（仍可在资产页手动点「立即探测」）
HOST_PROBE_INTERVAL_MINUTES=0

# ===== 告警 =====
# 超过该分钟数未再上报的未恢复告警自动关闭（0 = 不自动关闭）
ALERT_AUTO_RESOLVE_MINUTES=0

# ===== 任务执行 =====
TASK_DEFAULT_MAX_RETRIES=0
TASK_DEFAULT_TIMEOUT_SECONDS=0

# ===== 分布式调度（多实例部署时） =====
# 实例 ID，留空自动生成（主机名-pid）；容器部署建议显式指定
INSTANCE_ID=
# 设为 false 可让某实例只对外服务、不参与调度选主
SCHEDULER_ENABLED=true
SCHEDULER_LEASE_TTL=30
SCHEDULER_HEARTBEAT=10

# ===== LDAP 域账号登录 =====
LDAP_ENABLED=false
# LDAP_SERVER=ldap://dc.corp.local          # LDAPS 用 ldaps://dc.corp.local:636
# LDAP_BASE_DN=dc=corp,dc=local
# 服务账号（留空则用「用户 DN 模板」直连绑定）
# LDAP_BIND_DN=svc-autoops@corp.local
# LDAP_BIND_PASSWORD=
# AD 常用 (sAMAccountName={username})；OpenLDAP 用 (uid={username})
# LDAP_USER_FILTER=(sAMAccountName={username})
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=corp,dc=local
# 首次登录自动开户的默认角色与租户
# LDAP_DEFAULT_ROLE=operator
# LDAP_DEFAULT_TENANT=default

# ===== OIDC 单点登录（Authing / Keycloak / Azure AD / 钉钉等） =====
OIDC_ENABLED=false
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://your-domain/api/v1/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# IdP 组/角色 -> 平台角色映射，逗号分隔
# OIDC_ROLE_MAP=platform-admins:admin,ops-team:operator
# OIDC_DEFAULT_ROLE=operator
# OIDC_DEFAULT_TENANT=default
