# AutoOps 定时备份示例（/etc/cron.d/autoops-backup）
#
# 安装：
#   sudo cp deploy/backup.cron.example /etc/cron.d/autoops-backup
#   sudo chmod 644 /etc/cron.d/autoops-backup
#   sudo chown root:root /etc/cron.d/autoops-backup
#
# 说明：cron.d 格式比 crontab 多一个「用户」字段。
# 每日 03:00 备份（含产物归档），只保留最近 14 份。

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 3 * * * root APP_DIR=/opt/autoops /opt/autoops/deploy/backup.sh --with-artifacts --keep 14 >> /var/log/autoops-backup.log 2>&1

# 每周日 04:00 额外校验最近一份备份是否可读（哈希 + 表结构）
0 4 * * 0 root APP_DIR=/opt/autoops /opt/autoops/deploy/backup.sh --verify "$(ls -1t /opt/autoops/backend/backups | head -1)" >> /var/log/autoops-backup.log 2>&1
