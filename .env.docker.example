# Docker Compose 部署使用的环境变量
# 用法：cp .env.docker.example .env  然后修改下面的值（.env 已被 gitignore，不会提交）

# 对外访问端口（浏览器访问 http://服务器IP:8080）
WEB_PORT=8080

# ===== 必改：密钥 =====
# 生成方式：openssl rand -base64 48
SECRET_KEY=CHANGE_ME_openssl_rand_base64_48
# 凭据加密密钥，至少 32 字节
CREDENTIAL_SECRET=CHANGE_ME_at_least_32_bytes_long_secret

# ===== 数据库 =====
# 默认 SQLite（数据存在 autoops-data 卷）
DATABASE_URL=sqlite:////app/data/autoops.db
# 切 PostgreSQL 时改成下面这行，并加 --profile postgres 启动
# DATABASE_URL=postgresql+psycopg2://autoops:autoops@postgres:5432/autoops

# ===== 执行引擎 =====
# mock：模拟执行（演示/试用）；ansible：真实执行（镜像需 INSTALL_ANSIBLE=true 重新构建）
EXECUTOR_BACKEND=mock
INSTALL_ANSIBLE=false

# ===== 大模型（OpenAI 兼容，留空则走内置模板 Mock）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 其它 =====
TZ=Asia/Shanghai
CORS_ORIGINS=http://localhost:8080
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# SSO 回调后跳转的前端地址（改成实际访问地址）
FRONTEND_URL=http://localhost:8080

# ===== 分布式调度（扩多副本时每个容器显式指定 INSTANCE_ID）=====
SCHEDULER_ENABLED=true
SCHEDULER_LEASE_TTL=30
SCHEDULER_HEARTBEAT=10

# ===== 任务产物归档（默认本地卷；S3 兼容存储示例见 DEPLOY.md 第 8 节）=====
ARTIFACT_BACKEND=local
ARTIFACT_DIR=/app/data/artifacts
ARTIFACT_RETENTION_DAYS=30

# ===== 企业登录（LDAP / OIDC SSO，配置示例见 DEPLOY.md 第 9 节）=====
LDAP_ENABLED=false
OIDC_ENABLED=false

# 国内网络加速（构建时使用，可选）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
